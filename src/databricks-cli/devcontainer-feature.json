{
    "id": "databricks-cli",
    "version": "1.0.0",
    "name": "Databricks CLI (databricks)",
    "description": "Installs the Databricks CLI (`databricks`) from the official GitHub release, verified against the published SHA256 checksums. OAuth logins persist across rebuilds in a named volume.",
    "documentationURL": "https://github.com/ifm-pgarner/devcontainers-features/tree/main/src/databricks-cli",
    "licenseURL": "https://github.com/ifm-pgarner/devcontainers-features/blob/main/LICENSE",
    "options": {
        "version": {
            "type": "string",
            "default": "latest",
            "description": "Version of the Databricks CLI to install (e.g. 0.250.0). Use 'latest' for the newest release."
        }
    },
    "containerEnv": {
        "DATABRICKS_AUTH_STORAGE": "plaintext",
        "DATABRICKS_CONFIG_FILE": "/dc/databricks/.databrickscfg"
    },
    "entrypoint": "/usr/local/share/databricks-cli-init.sh",
    "mounts": [
        {
            "source": "databricks-cli-auth",
            "target": "/dc/databricks",
            "type": "volume"
        }
    ],
    "installsAfter": [
        "ghcr.io/devcontainers/features/common-utils"
    ]
}
